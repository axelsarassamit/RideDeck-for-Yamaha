<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="RideDeck migration helper (TEST ONLY)"
        android:testOnly="true" android:allowBackup="false" android:usesCleartextTraffic="false">
        <meta-data android:name="com.axelsarassamit.migrationhelper.EXPECTED_TARGET_APK_SHA256"
            android:value="${migrationTargetHash}" />
    </application>
    <instrumentation android:name="com.axelsarassamit.migrationhelper.MigrationInstrumentation"
        android:targetPackage="${migrationTarget}" android:handleProfiling="false"
        android:functionalTest="false" android:label="Explicit private migration only" />
</manifest>
